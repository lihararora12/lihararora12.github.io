---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Finding not found — vuln.management" description="This exposure could not be reproduced.">
  <section class="not-found shell">
    <p class="eyebrow">HTTP 404 · Inconclusive</p>
    <span class="stamp-404">Filed under: missing</span>
    <h1>Finding <span class="hl">not found.</span></h1>
    <p class="lede">We could not reproduce the requested page. It may have been remediated, moved, or accepted without sufficient documentation.</p>
    <div><a class="button" href="/">Return home</a><a class="button secondary" href="/memes/">Try a meme instead</a></div>
  </section>
</BaseLayout>

<style>
  .not-found { display: grid; min-height: 72vh; place-content: center; padding-block: 5rem; text-align: center; }
  .not-found .eyebrow { justify-content: center; }
  .not-found h1 {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 10rem);
    line-height: 0.9;
    transform: rotate(-2deg);
  }
  .not-found .lede { margin: 2rem auto; text-align: center; }
  .not-found > div { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.5rem; }
  .not-found .stamp-404 {
    display: inline-block;
    margin: 0 auto;
    padding: 0.4rem 1.4rem;
    border: 5px solid var(--tomato-deep);
    border-radius: 10px;
    color: var(--tomato-deep);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    transform: rotate(3deg);
  }
</style>
