---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdvisoryCard from '../components/AdvisoryCard.astro';
import SecretScanner from '../components/SecretScanner.astro';
import { isPublished, newestPostsFirst, newestAdvisoriesFirst } from '../lib/content';
import { DETECTORS } from '../lib/secret-scanner/detectors';

const posts = (await getCollection('posts')).filter(isPublished).sort(newestPostsFirst);
const advisories = (await getCollection('advisories')).filter(isPublished).sort(newestAdvisoriesFirst);
const detectorCount = DETECTORS.length;

// Patch forecast: weather-style read on the last 14 days of advisories.
const now = new Date();
const DAY = 86_400_000;
const recentAdvisories = advisories.filter(
  (a) => now.getTime() - a.data.advisoryDate.getTime() < 14 * DAY,
);
const actNowCount = recentAdvisories.filter((a) => a.data.priority === 'act-now').length;
const kevCount = recentAdvisories.filter((a) => a.data.kev).length;
const highCount = recentAdvisories.filter((a) => a.data.priority === 'high').length;
const condition = actNowCount > 0 || kevCount > 0 ? 'STORMY' : highCount > 0 ? 'ELEVATED' : 'CALM';
const conditionCopy = {
  STORMY: 'Known-exploited vulnerabilities are in the wild. Patch like it is raining.',
  ELEVATED: 'High-priority advisories are stacking up. Keep the umbrella within reach.',
  CALM: 'No fires on the board this week. Enjoy it; it will not last.',
}[condition];

const weekBars = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(now.getTime() - (6 - i) * DAY);
  const key = d.toISOString().slice(0, 10);
  const count = advisories.filter((a) => a.data.advisoryDate.toISOString().slice(0, 10) === key).length;
  return {
    label: d.toLocaleDateString('en-US', { weekday: 'narrow', timeZone: 'UTC' }),
    full: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }),
    count,
  };
});
const maxBar = Math.max(1, ...weekBars.map((b) => b.count));
const forecastDate = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

const tickerItems = advisories.slice(0, 10);
const blips = [
  { top: '22%', left: '64%', delay: '0s' },
  { top: '58%', left: '30%', delay: '0.9s' },
  { top: '70%', left: '68%', delay: '1.7s' },
  { top: '38%', left: '44%', delay: '2.4s' },
];
---

<BaseLayout>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <img class="hero-nebula" src="/images/nebula-hero.webp" alt="" aria-hidden="true" fetchpriority="high" />
    <canvas class="hero-stars" id="starfield" aria-hidden="true"></canvas>
    <div class="hero-veil" aria-hidden="true"></div>

    <div class="section-shell hero-inner">
      <div class="hero-copy">
        <p class="kicker"><span class="live-dot"></span>:MISSION CONTROL</p>
        <h1 class="display">Security is all about <span class="grad-text">context.</span></h1>
        <p class="lede">
          Practical security thinking for systems that increasingly write, deploy, and operate themselves. Fewer buzzwords. Better evidence. Occasional memes.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/advisories/">Check advisories</a>
          <a class="btn btn-ghost" href="#scanner-deck">Run the scanner ↓</a>
        </div>
        <div class="hero-telemetry mono" aria-label="Site telemetry">
          <span><strong>{advisories.length}</strong> advisories tracked</span>
          <span><strong>{detectorCount}</strong> detectors online</span>
          <span class="ok">STATUS: CONTEXT REQUIRED</span>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true" id="hero-visual">
        <div class="orbit-ring r1" style="animation-duration: 26s;"><span class="sat"></span></div>
        <div class="orbit-ring r2" style="animation-duration: 40s; animation-direction: reverse;"><span class="sat"></span></div>
        <div class="orbit-ring r3" style="animation-duration: 60s;"><span class="sat"></span></div>
        <div class="planet"></div>
        <div class="planet-ring"></div>
        <div class="hero-tag tag-float-1 mono">CVE-2026-93605 · vm2</div>
        <div class="hero-tag tag-float-2 mono">KEV // CONFIRMED</div>
      </div>
    </div>

    <div class="hero-scroll mono" aria-hidden="true">SCROLL ↓</div>
  </section>

  <!-- ================= TICKER ================= -->
  <div class="ticker-band" aria-label="Latest advisories ticker">
    <div class="marquee">
      <div class="marquee-track">
        {tickerItems.map((a) => (
          <span class="ticker-item mono">
            <i class:list={['ticker-dot', a.data.priority]}></i>
            <strong>{a.data.identifier}</strong> {a.data.vendor} {a.data.product}
          </span>
        ))}
        {tickerItems.map((a) => (
          <span class="ticker-item mono" aria-hidden="true">
            <i class:list={['ticker-dot', a.data.priority]}></i>
            <strong>{a.data.identifier}</strong> {a.data.vendor} {a.data.product}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ================= STATS ================= -->
  <section class="section-block stats-band" aria-label="Site statistics">
    <div class="section-shell stats-grid">
      <div class="stat reveal"><span class="stat-num" data-count={advisories.length}>0</span><span class="stat-label mono">advisories tracked</span></div>
      <div class="stat reveal"><span class="stat-num" data-count={posts.length}>0</span><span class="stat-label mono">field notes published</span></div>
      <div class="stat reveal"><span class="stat-num" data-count={detectorCount}>0</span><span class="stat-label mono">secret detectors</span></div>
      <div class="stat reveal"><span class="stat-num" data-count="39">0</span><span class="stat-label mono">memes deployed</span></div>
    </div>
  </section>

  <!-- ================= FORECAST ================= -->
  <section class="section-block" aria-labelledby="forecast-heading">
    <div class="section-shell forecast-grid">
      <div class="forecast-readout reveal">
        <p class="kicker">:PATCH FORECAST // {forecastDate}</p>
        <p class="forecast-condition display" data-condition={condition.toLowerCase()} id="forecast-heading">{condition}</p>
        <p class="forecast-copy">{conditionCopy}</p>
        <div class="forecast-meta mono">
          <span><strong>{recentAdvisories.length}</strong> advisories / 14d</span>
          <span><strong>{kevCount}</strong> known-exploited</span>
          <span><strong>{actNowCount}</strong> act-now</span>
        </div>
        <div class="forecast-week" role="img" aria-label={`Advisories published per day over the last 7 days, ending ${forecastDate}`}>
          {weekBars.map((b) => (
            <div class="forecast-day">
              <span class="forecast-count mono">{b.count > 0 ? b.count : ''}</span>
              <div class="forecast-bar" style={`--h: ${(b.count / maxBar * 100).toFixed(0)}%`} title={`${b.full}: ${b.count} advisories`}></div>
              <span class="forecast-label mono">{b.label}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="radar-wrap reveal">
        <div class="radar radar-lg" role="img" aria-label="Threat radar sweep">
          {blips.map((b) => <span class="blip" style={`top:${b.top};left:${b.left};animation-delay:${b.delay};`}></span>)}
        </div>
        <p class="radar-caption mono">DEEP-FIELD SCAN · SWEEP 03 · {kevCount + actNowCount} CONTACTS</p>
      </div>
    </div>
  </section>

  <!-- ================= ADVISORIES ================= -->
  <section class="section-block advisory-band" aria-labelledby="advisory-heading">
    <div class="section-shell">
      <div class="section-head reveal">
        <div>
          <p class="kicker">:ADVISORY DESK</p>
          <h2 id="advisory-heading">Known exploitation already skipped the prioritization meeting.</h2>
        </div>
        <a class="text-link" href="/advisories/">All advisories →</a>
      </div>
      <div class="card-grid">
        {advisories.slice(0, 3).map((entry) => <AdvisoryCard entry={entry} />)}
      </div>
    </div>
  </section>

  <!-- ================= SCANNER DECK ================= -->
  <section class="section-block" id="scanner-deck" aria-labelledby="scanner-heading">
    <div class="section-shell">
      <div class="section-head reveal">
        <div>
          <p class="kicker"><span class="live-dot"></span>:FLIGHT DECK // LIVE DEMO</p>
          <h2 id="scanner-heading">Find leaked secrets without leaking them.</h2>
        </div>
      </div>
      <p class="deck-lede reveal">Paste code, config, or logs below. {detectorCount} detectors run entirely in your browser and return redacted findings, reasoned risk scores, and rotation guidance. Nothing uploads. Nothing phones home.</p>
      <div class="reveal">
        <SecretScanner />
      </div>
    </div>
  </section>

  <!-- ================= POSTS ================= -->
  <section class="section-block" aria-labelledby="latest-posts">
    <div class="section-shell">
      <div class="section-head reveal">
        <div>
          <p class="kicker">:LATEST TRANSMISSIONS</p>
          <h2 id="latest-posts">For the work after the scanner finishes yelling.</h2>
        </div>
        <a class="text-link" href="/posts/">All posts →</a>
      </div>
      <div class="card-grid">
        {posts.slice(0, 3).map((entry, index) => <PostCard entry={entry} index={index} />)}
      </div>
    </div>
  </section>

  <!-- ================= MEMES ================= -->
  <section class="section-block">
    <div class="section-shell">
      <div class="meme-deck glass reveal" data-tilt>
        <div class="card-glow"></div>
        <div class="meme-frame">
          <img src="/images/photos/memes-24.jpg" alt="Security meme from the archive" loading="lazy" />
        </div>
        <div class="meme-copy">
          <p class="kicker">:COMPENSATING CONTROL</p>
          <h2 class="display">When remediation is blocked, deploy humor.</h2>
          <a class="btn btn-primary" href="/memes/">Open the meme archive</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ---------- starfield ----------
  (() => {
    const canvas = document.getElementById('starfield');
    if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    let w = 0, h = 0, mx = 0, my = 0;
    const stars: Array<{ x: number; y: number; r: number; tw: number; ts: number; depth: number }> = [];
    const N = 170;
    const resize = () => {
      const r = canvas.getBoundingClientRect();
      w = canvas.width = r.width;
      h = canvas.height = r.height;
    };
    const seed = () => {
      stars.length = 0;
      for (let i = 0; i < N; i++) {
        stars.push({
          x: Math.random(), y: Math.random(),
          r: Math.random() * 1.4 + 0.3,
          tw: Math.random() * Math.PI * 2,
          ts: 0.008 + Math.random() * 0.03,
          depth: 0.25 + Math.random() * 0.75,
        });
      }
    };
    let meteor: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
    const throwMeteor = () => {
      meteor = { x: Math.random() * 0.7 + 0.15, y: -0.05, vx: -(0.004 + Math.random() * 0.004), vy: 0.006 + Math.random() * 0.004, life: 1 };
      window.setTimeout(throwMeteor, 5000 + Math.random() * 9000);
    };
    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      const ox = mx * 18, oy = my * 12;
      for (const s of stars) {
        const a = 0.35 + 0.65 * Math.abs(Math.sin(t * s.ts + s.tw));
        ctx.globalAlpha = a * s.depth;
        ctx.fillStyle = '#dfe6ff';
        ctx.beginPath();
        ctx.arc(s.x * w + ox * s.depth, s.y * h + oy * s.depth, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (meteor) {
        meteor.x += meteor.vx; meteor.y += meteor.vy; meteor.life -= 0.012;
        if (meteor.life <= 0 || meteor.y > 1.1) meteor = null;
        else {
          const x = meteor.x * w, y = meteor.y * h;
          const grad = ctx.createLinearGradient(x, y, x - meteor.vx * w * 14, y - meteor.vy * h * 14);
          grad.addColorStop(0, `rgba(255,170,110,${0.9 * meteor.life})`);
          grad.addColorStop(1, 'rgba(255,170,110,0)');
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.lineTo(x - meteor.vx * w * 14, y - meteor.vy * h * 14);
          ctx.stroke();
        }
      }
      requestAnimationFrame(draw);
    };
    window.addEventListener('resize', resize);
    window.addEventListener('pointermove', (e) => {
      mx = e.clientX / window.innerWidth - 0.5;
      my = e.clientY / window.innerHeight - 0.5;
    }, { passive: true });
    resize(); seed(); throwMeteor();
    requestAnimationFrame(draw);
  })();

  // ---------- reveal on scroll ----------
  (() => {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  })();

  // ---------- count-up stats ----------
  (() => {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target;
        io.unobserve(el);
        const target = parseInt(el.getAttribute('data-count') || '0', 10);
        const dur = 1300, t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
  })();

  // ---------- tilt cards ----------
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e: PointerEvent) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `perspective(900px) rotateX(${(-py * 5).toFixed(2)}deg) rotateY(${(px * 7).toFixed(2)}deg) translateY(-4px)`;
      });
      card.addEventListener('pointerleave', () => { card.style.transform = ''; });
    });
  })();

  // ---------- hero visual parallax ----------
  (() => {
    const visual = document.getElementById('hero-visual');
    if (!visual || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    window.addEventListener('pointermove', (e) => {
      const x = e.clientX / window.innerWidth - 0.5;
      const y = e.clientY / window.innerHeight - 0.5;
      visual.style.transform = `translate(${x * 22}px, ${y * 16}px)`;
    }, { passive: true });
  })();
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: max(92vh, 620px);
    display: flex;
    align-items: center;
    overflow: clip;
    isolation: isolate;
  }
  .hero-nebula {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.5;
    z-index: -3;
  }
  .hero-stars {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    z-index: -2;
  }
  .hero-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(4,6,12,0.55) 0%, transparent 30%, transparent 62%, var(--void) 100%),
      radial-gradient(900px 480px at 30% 45%, transparent 40%, rgba(4,6,12,0.5) 100%);
    z-index: -1;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    width: 100%;
    padding-block: 7rem 4rem;
  }
  .hero-copy .display {
    font-size: clamp(3.2rem, 7.2vw, 6.4rem);
    margin: 1.1rem 0 0;
    max-width: 12ch;
    text-wrap: balance;
    text-shadow: 0 4px 40px rgba(0,0,0,0.6);
  }
  .lede {
    margin: 1.5rem 0 0;
    max-width: 44ch;
    color: #c3c9e4;
    font-size: 1.08rem;
    line-height: 1.65;
    text-shadow: 0 2px 18px rgba(0,0,0,0.7);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .hero-telemetry {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: 2.4rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .hero-telemetry strong { color: var(--ink); font-size: 0.85rem; margin-right: 0.3em; }
  .hero-telemetry .ok { color: var(--lime); }

  .hero-visual {
    position: relative;
    height: clamp(320px, 34vw, 480px);
    transition: transform 0.25s ease-out;
  }
  .hero-visual .orbit-ring { inset: 0; margin: auto; }
  .orbit-ring.r1 { width: 62%; aspect-ratio: 1; }
  .orbit-ring.r2 { width: 84%; aspect-ratio: 1; border-style: dashed; }
  .orbit-ring.r3 { width: 106%; aspect-ratio: 1; opacity: 0.6; }
  .planet {
    position: absolute;
    inset: 0; margin: auto;
    width: 34%; aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, #ffb37e 0%, var(--orange) 34%, #7a2c08 72%, #1c0d04 100%);
    box-shadow:
      0 0 60px rgba(255,106,26,0.55),
      0 0 160px rgba(255,106,26,0.25),
      inset -18px -22px 50px rgba(0,0,0,0.55);
    animation: planet-float 7s ease-in-out infinite;
  }
  @keyframes planet-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  .planet-ring {
    position: absolute;
    inset: 0; margin: auto;
    width: 58%; aspect-ratio: 2.6;
    border: 2px solid rgba(255,138,61,0.5);
    border-radius: 50%;
    transform: rotate(-18deg);
    box-shadow: 0 0 24px rgba(255,106,26,0.25);
    animation: planet-float 7s ease-in-out infinite reverse;
  }
  .hero-tag {
    position: absolute;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--cyan);
    border: 1px solid rgba(110,231,249,0.35);
    background: rgba(6,10,20,0.7);
    padding: 0.5em 0.9em;
    border-radius: 8px;
    backdrop-filter: blur(8px);
    white-space: nowrap;
  }
  .tag-float-1 { top: 6%; right: 2%; animation: planet-float 6s ease-in-out infinite; }
  .tag-float-2 { bottom: 10%; left: 0; color: #ff8ba0; border-color: rgba(255,61,94,0.4); animation: planet-float 8s ease-in-out infinite reverse; }
  .hero-scroll {
    position: absolute;
    bottom: 1.4rem; left: 50%;
    transform: translateX(-50%);
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    color: var(--faint);
    animation: planet-float 3s ease-in-out infinite;
  }

  /* ---------- ticker ---------- */
  .ticker-band {
    border-block: 1px solid var(--hairline);
    background: rgba(8,11,22,0.6);
    padding: 0.95rem 0;
    backdrop-filter: blur(8px);
  }
  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .ticker-item strong { color: var(--ink); }
  .ticker-dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
  .ticker-dot.act-now { background: var(--ember); box-shadow: 0 0 10px var(--ember); }
  .ticker-dot.high { background: var(--amber); box-shadow: 0 0 10px var(--amber); }
  .ticker-dot.watch { background: #34d399; box-shadow: 0 0 10px #34d399; }

  /* ---------- stats ---------- */
  .stats-band { border-bottom: 1px solid var(--hairline-soft); }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .stat { display: flex; flex-direction: column; gap: 0.6rem; }
  .stat-num { font-size: clamp(3rem, 5.5vw, 5rem); }
  .stat-label {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- forecast ---------- */
  .forecast-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .forecast-condition {
    margin: 1rem 0 0;
    font-size: clamp(3.4rem, 7vw, 6rem);
    letter-spacing: -0.04em;
  }
  .forecast-condition[data-condition="stormy"] { color: var(--ember); text-shadow: 0 0 44px rgba(255,61,94,0.5); }
  .forecast-condition[data-condition="elevated"] { color: var(--amber); text-shadow: 0 0 44px rgba(255,176,32,0.45); }
  .forecast-condition[data-condition="calm"] { color: var(--lime); text-shadow: 0 0 44px rgba(215,247,91,0.35); }
  .forecast-copy { margin: 1rem 0 0; max-width: 38ch; color: #c3c9e4; font-size: 1.05rem; line-height: 1.6; }
  .forecast-meta {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem;
    margin: 1.4rem 0 0;
    font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted);
  }
  .forecast-meta strong { color: var(--orange-hot); font-size: 0.95rem; margin-right: 0.3em; }
  .forecast-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.7rem; margin-top: 2rem; max-width: 30rem; }
  .forecast-day { display: flex; min-height: 8rem; flex-direction: column; align-items: center; justify-content: flex-end; gap: 0.4rem; }
  .forecast-count { min-height: 1rem; font-size: 0.68rem; font-weight: 700; color: var(--orange-hot); }
  .forecast-bar {
    width: 100%; max-width: 2.4rem;
    height: var(--h); min-height: 4px;
    border-radius: 6px 6px 2px 2px;
    background: linear-gradient(180deg, var(--orange-hot), rgba(255,106,26,0.25));
    box-shadow: 0 0 18px rgba(255,106,26,0.35);
    transition: height 0.6s cubic-bezier(0.2, 0.7, 0.3, 1.2);
  }
  .forecast-day:hover .forecast-bar { background: linear-gradient(180deg, #ffd9b8, var(--orange)); }
