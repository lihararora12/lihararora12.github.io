---
import type { CollectionEntry } from 'astro:content';
import { advisoryUrl } from '../lib/content';

interface Props {
  advisories: CollectionEntry<'advisories'>[];
}

const { advisories } = Astro.props;

const slugify = (value: string) => value
  .normalize('NFKD')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '');

const unique = (values: string[]) => [...new Set(values)].sort((a, b) => a.localeCompare(b));
const priorityLabels = { 'act-now': 'Act now', high: 'High priority', watch: 'Watch' };
const facets = [
  { key: 'technology', label: 'Technology', values: unique(advisories.flatMap(({ data }) => data.technologies)) },
  { key: 'weakness', label: 'Weakness', values: unique(advisories.flatMap(({ data }) => data.weaknesses)) },
  { key: 'impact', label: 'Impact', values: unique(advisories.flatMap(({ data }) => data.impacts)) },
  { key: 'evidence', label: 'Evidence', values: unique(advisories.flatMap(({ data }) => data.evidence)) },
  { key: 'action', label: 'Action', values: unique(advisories.flatMap(({ data }) => data.actions)) },
];

const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const shortDateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

const fullDate = (entry: CollectionEntry<'advisories'>) =>
  entry.data.advisoryDateLabel ?? dateFormatter.format(entry.data.advisoryDate);
const shortDate = (entry: CollectionEntry<'advisories'>) =>
  entry.data.advisoryDateLabel ?? shortDateFormatter.format(entry.data.advisoryDate);
const resultData = (entry: CollectionEntry<'advisories'>) => ({
  search: [
    entry.data.identifier,
    entry.data.vendor,
    entry.data.product,
    entry.data.title,
    entry.data.summary,
    entry.data.status,
    ...entry.data.technologies,
    ...entry.data.cwes,
    ...entry.data.weaknesses,
    ...entry.data.impacts,
    ...entry.data.evidence,
    ...entry.data.actions,
  ].join(' ').toLowerCase(),
  priority: entry.data.priority,
  technology: entry.data.technologies.map(slugify).join(' '),
  weakness: entry.data.weaknesses.map(slugify).join(' '),
  impact: entry.data.impacts.map(slugify).join(' '),
  evidence: entry.data.evidence.map(slugify).join(' '),
  action: entry.data.actions.map(slugify).join(' '),
});

const groups = new Map<string, CollectionEntry<'advisories'>[]>();
for (const entry of advisories) {
  const key = entry.data.advisoryDate.toISOString().slice(0, 7);
  groups.set(key, [...(groups.get(key) ?? []), entry]);
}
---

<div class="advisory-explorer" data-explorer>
  <div class="explorer-topline">
    <h1>Advisory explorer</h1>
    <p><strong data-result-count>{advisories.length}</strong> of {advisories.length} advisories</p>
  </div>

  <form class="search-row" role="search" data-search-form>
    <label class="search-box">
      <span class="sr-only">Search advisories</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input
        type="search"
        placeholder="Search CVE, vendor, product, or technology"
        autocomplete="off"
        data-search-input
      />
      <kbd aria-hidden="true">/</kbd>
    </label>
    <div class="view-switcher" aria-label="Results view">
      <button type="button" data-view="timeline" aria-pressed="true">Timeline</button>
      <button type="button" data-view="compact" aria-pressed="false">Compact</button>
    </div>
  </form>

  <div class="quick-row" aria-label="Quick views">
    <span>Quick views</span>
    <button type="button" data-preset="act-now" aria-pressed="false">Act now</button>
    <button type="button" data-preset="ai-agents" aria-pressed="false">AI &amp; agents</button>
    <button type="button" data-preset="known-exploited" aria-pressed="false">Known exploited</button>
    <button type="button" class="clear-all" data-clear hidden>Clear filters</button>
  </div>

  <details class="filter-drawer">
    <summary>
      <span>Filter by signal</span>
      <span class="active-filter-count" data-filter-count>0 active</span>
    </summary>
    <div class="facet-grid">
      {facets.map((facet) => (
        <fieldset>
          <legend>{facet.label}</legend>
          <div class="facet-options">
            {facet.values.map((value) => (
              <button
                type="button"
                data-filter-group={facet.key}
                data-filter-value={slugify(value)}
                aria-pressed="false"
              >
                {value}
              </button>
            ))}
          </div>
        </fieldset>
      ))}
    </div>
  </details>

  <p class="results-status sr-only" aria-live="polite" data-results-status></p>

  <div class="timeline" data-timeline-view>
    {Array.from(groups.values()).map((entries) => (
      <section class="timeline-month" data-month-group>
        <h2>{monthFormatter.format(entries[0].data.advisoryDate)}</h2>
        <div class="timeline-list">
          {entries.map((entry) => {
            const data = resultData(entry);
            return (
              <article
                class="timeline-item"
                data-result
                data-search={data.search}
                data-priority={data.priority}
                data-technology={data.technology}
                data-weakness={data.weakness}
                data-impact={data.impact}
                data-evidence={data.evidence}
                data-action={data.action}
              >
                <div class="timeline-date">
                  <time datetime={entry.data.advisoryDate.toISOString().slice(0, 10)}>{shortDate(entry)}</time>
                  <span class:list={['priority-dot', entry.data.priority]} aria-hidden="true"></span>
                </div>
                <a class="timeline-card" href={advisoryUrl(entry)}>
                  <div class="item-meta">
                    <code>{entry.data.identifier}</code>
                    <span>{entry.data.status}</span>
                  </div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.summary}</p>
                  <div class="item-footer">
                    <div class="result-tags" aria-label="Advisory tags">
                      {entry.data.technologies.map((tag) => <span>{tag}</span>)}
                      {entry.data.weaknesses.map((tag) => <span>{tag}</span>)}
                    </div>
                    <span class="read-link">Read advisory <span aria-hidden="true">→</span></span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <div class="compact-view" data-compact-view hidden>
    <table>
      <thead>
        <tr>
          <th scope="col">Published</th>
          <th scope="col">Advisory</th>
          <th scope="col">Technology</th>
          <th scope="col">Signal</th>
          <th scope="col">Priority</th>
        </tr>
      </thead>
      <tbody>
        {advisories.map((entry) => {
          const data = resultData(entry);
          return (
            <tr
              data-result
              data-search={data.search}
              data-priority={data.priority}
              data-technology={data.technology}
              data-weakness={data.weakness}
              data-impact={data.impact}
              data-evidence={data.evidence}
              data-action={data.action}
            >
              <td><time datetime={entry.data.advisoryDate.toISOString().slice(0, 10)}>{fullDate(entry)}</time></td>
              <td>
                <a href={advisoryUrl(entry)}>{entry.data.vendor} {entry.data.product}</a>
                <code>{entry.data.identifier}</code>
              </td>
              <td>{entry.data.technologies.join(', ')}</td>
              <td>{entry.data.status}</td>
              <td><span class:list={['compact-priority', entry.data.priority]}>{priorityLabels[entry.data.priority]}</span></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="empty-state" data-empty-state hidden>
    <strong>Zero advisories found.</strong>
    <p>Either the filters are too specific, or security has finally been solved. Probably the filters.</p>
    <button type="button" data-clear>Reset the evidence</button>
  </div>
</div>

<script>
  const explorer = document.querySelector<HTMLElement>('[data-explorer]');

  if (explorer) {
    const searchInput = explorer.querySelector<HTMLInputElement>('[data-search-input]');
    const searchForm = explorer.querySelector<HTMLFormElement>('[data-search-form]');
    const resultCount = explorer.querySelector<HTMLElement>('[data-result-count]');
    const resultsStatus = explorer.querySelector<HTMLElement>('[data-results-status]');
    const filterCount = explorer.querySelector<HTMLElement>('[data-filter-count]');
    const emptyState = explorer.querySelector<HTMLElement>('[data-empty-state]');
    const timelineView = explorer.querySelector<HTMLElement>('[data-timeline-view]');
    const compactView = explorer.querySelector<HTMLElement>('[data-compact-view]');
    const timelineResults = Array.from(explorer.querySelectorAll<HTMLElement>('[data-timeline-view] [data-result]'));
    const allResults = Array.from(explorer.querySelectorAll<HTMLElement>('[data-result]'));
    const monthGroups = Array.from(explorer.querySelectorAll<HTMLElement>('[data-month-group]'));
    const filterButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-filter-group]'));
    const presetButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-preset]'));
    const viewButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-view]'));
    const clearButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-clear]'));
    const filters = new Map<string, Set<string>>();
    const validFilters = new Map<string, Set<string>>();
    let view = 'timeline';

    for (const button of filterButtons) {
      const group = button.dataset.filterGroup;
      const value = button.dataset.filterValue;
      if (!group || !value) continue;
      if (!validFilters.has(group)) validFilters.set(group, new Set());
      validFilters.get(group)?.add(value);
    }
    validFilters.set('priority', new Set(['act-now', 'high', 'watch']));

    const setFilter = (group: string, values: string[]) => {
      const allowed = validFilters.get(group);
      const clean = values.filter((value) => allowed?.has(value));
      if (clean.length) filters.set(group, new Set(clean));
      else filters.delete(group);
    };

    const activeFilterTotal = () =>
      Array.from(filters.values()).reduce((total, values) => total + values.size, 0);

    const matchesPreset = (name: string) => {
      if (searchInput?.value.trim()) return false;
      const expected: Record<string, Record<string, string[]>> = {
        'act-now': { priority: ['act-now'] },
        'ai-agents': { technology: ['ai', 'agent-workflows'] },
        'known-exploited': { evidence: ['cisa-kev', 'vendor-confirmed-exploitation'] },
      };
      const preset = expected[name];
      if (!preset || filters.size !== Object.keys(preset).length) return false;
      return Object.entries(preset).every(([group, values]) => {
        const active = filters.get(group);
        return active?.size === values.length && values.every((value) => active.has(value));
      });
    };

    const syncUrl = () => {
      const params = new URLSearchParams();
      const query = searchInput?.value.trim();
      if (query) params.set('q', query);
      for (const [group, values] of filters) params.set(group, Array.from(values).join(','));
      if (view === 'compact') params.set('view', 'compact');
      const queryString = params.toString();
      history.replaceState({}, '', `${location.pathname}${queryString ? `?${queryString}` : ''}${location.hash}`);
    };

    const apply = (updateUrl = true) => {
      const queryTokens = (searchInput?.value ?? '').trim().toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;

      for (const result of allResults) {
        const matchesQuery = queryTokens.every((token) => (result.dataset.search ?? '').includes(token));
        const matchesFilters = Array.from(filters.entries()).every(([group, values]) => {
          const available = new Set((result.dataset[group] ?? '').split(' ').filter(Boolean));
          return Array.from(values).some((value) => available.has(value));
        });
        result.hidden = !(matchesQuery && matchesFilters);
      }

      for (const result of timelineResults) if (!result.hidden) visible += 1;
      for (const group of monthGroups) {
        group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('[data-result]')).some((result) => !result.hidden);
      }

      const active = activeFilterTotal();
      if (resultCount) resultCount.textContent = String(visible);
      if (resultsStatus) resultsStatus.textContent = `${visible} ${visible === 1 ? 'advisory' : 'advisories'} shown`;
      if (filterCount) filterCount.textContent = `${active} active`;
      if (emptyState) emptyState.hidden = visible !== 0;

      for (const button of filterButtons) {
        const group = button.dataset.filterGroup ?? '';
        const value = button.dataset.filterValue ?? '';
        button.setAttribute('aria-pressed', String(filters.get(group)?.has(value) ?? false));
      }
      for (const button of presetButtons) {
        button.setAttribute('aria-pressed', String(matchesPreset(button.dataset.preset ?? '')));
      }
      for (const button of clearButtons) button.hidden = active === 0 && !searchInput?.value.trim();
      if (updateUrl) syncUrl();
    };

    const setView = (nextView: string, updateUrl = true) => {
      view = nextView === 'compact' ? 'compact' : 'timeline';
      if (timelineView) timelineView.hidden = view !== 'timeline';
      if (compactView) compactView.hidden = view !== 'compact';
      for (const button of viewButtons) button.setAttribute('aria-pressed', String(button.dataset.view === view));
      if (updateUrl) syncUrl();
    };

    const clearAll = () => {
      filters.clear();
      if (searchInput) searchInput.value = '';
      apply();
    };

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        const group = button.dataset.filterGroup;
        const value = button.dataset.filterValue;
        if (!group || !value) return;
        const values = new Set(filters.get(group) ?? []);
        if (values.has(value)) values.delete(value);
        else values.add(value);
        setFilter(group, Array.from(values));
        apply();
      });
    }

    for (const button of presetButtons) {
      button.addEventListener('click', () => {
        const preset = button.dataset.preset;
        const alreadyActive = matchesPreset(preset ?? '');
        filters.clear();
        if (searchInput) searchInput.value = '';
        if (!alreadyActive && preset === 'act-now') setFilter('priority', ['act-now']);
        if (!alreadyActive && preset === 'ai-agents') setFilter('technology', ['ai', 'agent-workflows']);
        if (!alreadyActive && preset === 'known-exploited') {
          setFilter('evidence', ['cisa-kev', 'vendor-confirmed-exploitation']);
        }
        apply();
      });
    }

    for (const button of viewButtons) button.addEventListener('click', () => setView(button.dataset.view ?? 'timeline'));
    for (const button of clearButtons) button.addEventListener('click', clearAll);
    searchInput?.addEventListener('input', () => apply());
    searchForm?.addEventListener('submit', (event) => event.preventDefault());

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement;
      if (event.key === '/' && !isTyping) {
        event.preventDefault();
        searchInput?.focus();
      }
    });

    const params = new URLSearchParams(location.search);
    if (searchInput) searchInput.value = params.get('q') ?? '';
    for (const group of validFilters.keys()) setFilter(group, (params.get(group) ?? '').split(',').filter(Boolean));
    setView(params.get('view') ?? 'timeline', false);
    apply(false);
  }
</script>

<style>
  .advisory-explorer { --rail: 8.5rem; }

  .explorer-topline {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }
  .explorer-topline h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    line-height: 0.95;
    transform: rotate(-0.8deg);
  }
  .explorer-topline h1 .hl { white-space: nowrap; }
  .explorer-topline p {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .explorer-topline strong {
    display: inline-block;
    background: var(--ink);
    color: var(--mustard);
    padding: 0.2em 0.55em;
    border-radius: 6px;
    transform: rotate(-2deg);
  }

  .search-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.75rem; }
  .search-box {
    display: grid;
    min-height: 3.5rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    border: var(--bd);
    border-radius: 12px;
    background: #fff;
    box-shadow: var(--shadow-hard-sm);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .search-box:focus-within { transform: translate(-2px, -2px); box-shadow: var(--shadow-hard); outline: none; }
  .search-box svg { fill: none; stroke: var(--tomato-deep); stroke-linecap: round; stroke-width: 2.2; }
  .search-box input { min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font: 600 0.95rem var(--font-body); }
  .search-box input::placeholder { color: var(--faint); }
  .search-box kbd {
    padding: 0.15rem 0.5rem;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--mustard-soft);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .view-switcher {
    display: flex;
    padding: 0.3rem;
    border: var(--bd);
    border-radius: 12px;
    background: var(--card);
    box-shadow: var(--shadow-hard-sm);
  }
  .view-switcher button,
  .quick-row button,
  .facet-options button,
  .empty-state button {
    border: 2px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    transition: all 0.14s;
  }
  .view-switcher button { min-width: 5.7rem; padding: 0.6rem 0.75rem; text-transform: uppercase; }
  .view-switcher button:hover { color: var(--ink); background: var(--mustard-soft); }
  .view-switcher button[aria-pressed="true"] { background: var(--ink); color: var(--mustard); transform: rotate(-1deg); }

  .quick-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; padding: 0.9rem 0; }
  .quick-row > span { margin-right: 0.25rem; color: var(--muted); font-family: var(--font-mono); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
  .quick-row button, .facet-options button { padding: 0.42rem 0.7rem; border-color: var(--ink); background: var(--card); color: var(--ink); box-shadow: 2px 2px 0 var(--ink); }
  .quick-row button:hover, .facet-options button:hover { transform: translate(-1px, -1px) rotate(-1deg); box-shadow: 3px 3px 0 var(--ink); }
  .quick-row button[aria-pressed="true"], .facet-options button[aria-pressed="true"] {
    border-color: var(--ink);
    background: var(--tomato);
    color: #fff8ee;
    transform: rotate(1deg);
  }
  .quick-row .clear-all { margin-left: auto; border: 0; box-shadow: none; color: var(--tomato-deep); text-decoration: underline; text-underline-offset: 0.2em; font-weight: 700; }

  .filter-drawer {
    margin-bottom: 2rem;
    border: var(--bd);
    border-radius: 12px;
    background: var(--card);
    box-shadow: var(--shadow-hard-sm);
  }
  .filter-drawer summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .filter-drawer summary::marker { color: var(--tomato-deep); }
  .active-filter-count {
    background: var(--tomato);
    color: #fff8ee;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.15em 0.7em;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    transform: rotate(2deg);
  }
  .facet-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; padding: 1rem 1.1rem 1.2rem; border-top: var(--bd-thin); }
  .facet-grid fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .facet-grid legend { margin-bottom: 0.6rem; color: var(--tomato-deep); font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .facet-options { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .timeline-month { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); gap: 1.4rem; }
  .timeline-month + .timeline-month { margin-top: 2.4rem; }
  .timeline-month > h2 {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.95rem;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }
  .timeline-list { position: relative; display: grid; gap: 1rem; }
  .timeline-list::before { position: absolute; top: 0; bottom: -2.2rem; left: -1.4rem; width: 4px; background: var(--ink); border-radius: 4px; content: ""; opacity: 0.9; }
  .timeline-month:last-child .timeline-list::before { bottom: 0; }

  .timeline-item { position: relative; display: grid; grid-template-columns: 5.8rem minmax(0, 1fr); gap: 0.85rem; }
  .timeline-item::before {
    position: absolute;
    top: 1.3rem; left: -1.78rem;
    width: 1rem; height: 1rem;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--mustard);
    content: "";
    z-index: 1;
  }
  .timeline-date {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    align-self: start;
    padding-top: 1.05rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-align: right;
  }
  .priority-dot { width: 0.7rem; height: 0.7rem; flex: 0 0 auto; border: 2px solid var(--ink); border-radius: 50%; background: var(--muted); }
  .priority-dot.act-now { background: var(--tomato); }
  .priority-dot.high { background: var(--mustard); }
  .priority-dot.watch { background: var(--teal); }

  .timeline-card {
    display: block;
    padding: 1.1rem 1.15rem;
    border: var(--bd);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow-hard-sm);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.16s, box-shadow 0.16s;
  }
  .timeline-card:hover { color: var(--ink); box-shadow: var(--shadow-hard); transform: translate(-2px, -2px) rotate(-0.4deg); }
  .item-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; color: var(--muted); font-family: var(--font-mono); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
