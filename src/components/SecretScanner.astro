<section class="scanner" data-secret-scanner>
  <div class="scanner-statusbar">
    <span><i></i><strong id="detector-count">Loading</strong> local detectors</span>
    <span>MAX_INPUT 2 MB</span>
    <span>NETWORK OFF</span>
  </div>

  <div class="scanner-grid" id="drop-zone">
    <section class="input-panel" aria-labelledby="scanner-input-title">
      <header class="panel-header">
        <div>
          <span class="panel-index">01 / INPUT</span>
          <h2 id="scanner-input-title">Inspect source material</h2>
        </div>
        <span class="privacy-state">LOCAL MEMORY ONLY</span>
      </header>

      <div class="source-field">
        <label for="source-name">Source label</label>
        <input id="source-name" value="Pasted text" spellcheck="false" />
      </div>

      <label class="sr-only" for="scan-input">Text to scan</label>
      <textarea id="scan-input" spellcheck="false" placeholder="# Paste source code, configuration, logs, or an environment file here…"></textarea>

      <div class="input-meta">
        <span id="input-size">0 BYTES</span>
        <span>CTRL / ⌘ + ENTER TO SCAN</span>
      </div>

      <div class="scanner-actions">
        <button class="scanner-button primary" id="scan-button" type="button">RUN LOCAL SCAN <span aria-hidden="true">→</span></button>
        <button class="scanner-button" id="file-button" type="button">CHOOSE FILE</button>
        <button class="scanner-button" id="example-button" type="button">LOAD SAFE EXAMPLE</button>
        <button class="scanner-button quiet" id="clear-button" type="button">CLEAR</button>
        <input id="file-input" type="file" accept=".txt,.env,.log,.md,.json,.yaml,.yml,.js,.jsx,.ts,.tsx,.py,.rb,.go,.java,.sh,.properties,.toml" hidden />
      </div>

      <p class="privacy-note"><strong>No upload step exists.</strong> Files are read by your browser, scanned in memory, and discarded when the tab closes.</p>
    </section>

    <section class="results-panel" aria-labelledby="scanner-results-title" aria-live="polite">
      <header class="panel-header">
        <div>
          <span class="panel-index">02 / REVIEW</span>
          <h2 id="scanner-results-title">Findings</h2>
        </div>
        <button class="export-button" id="export-button" type="button" hidden>EXPORT MASKED JSON</button>
      </header>

      <div class="summary" id="summary" hidden>
        <button type="button" data-filter="all" class="active"><strong id="count-all">0</strong><span>ALL</span></button>
        <button type="button" data-filter="critical"><strong id="count-critical">0</strong><span>CRITICAL</span></button>
        <button type="button" data-filter="high"><strong id="count-high">0</strong><span>HIGH</span></button>
        <button type="button" data-filter="medium"><strong id="count-medium">0</strong><span>MEDIUM</span></button>
        <button type="button" data-filter="low"><strong id="count-low">0</strong><span>REVIEW</span></button>
      </div>

      <div class="empty-state" id="empty-state">
        <span class="empty-icon" aria-hidden="true">⌁</span>
        <h3>Ready when you are.</h3>
        <p>Add source material on the left. Results are pattern matches, not proof that a credential is active.</p>
      </div>
      <div class="finding-list" id="finding-list" hidden></div>
    </section>
  </div>

  <div class="scanner-footnote">
    <span>Pattern detection + local context analysis</span>
    <span id="scanner-message" role="status">No source has left this browser.</span>
  </div>
</section>

<script>
  import { scanner, type RiskLevel, type ScanResult } from '../lib/secret-scanner/scanner.ts';

  const MAX_FILE_BYTES = 2 * 1024 * 1024;
  const root = document.querySelector<HTMLElement>('[data-secret-scanner]');
  const input = root?.querySelector<HTMLTextAreaElement>('#scan-input');
  const sourceName = root?.querySelector<HTMLInputElement>('#source-name');
  const scanButton = root?.querySelector<HTMLButtonElement>('#scan-button');
  const fileButton = root?.querySelector<HTMLButtonElement>('#file-button');
  const fileInput = root?.querySelector<HTMLInputElement>('#file-input');
  const exampleButton = root?.querySelector<HTMLButtonElement>('#example-button');
  const clearButton = root?.querySelector<HTMLButtonElement>('#clear-button');
  const exportButton = root?.querySelector<HTMLButtonElement>('#export-button');
  const dropZone = root?.querySelector<HTMLElement>('#drop-zone');
  const emptyState = root?.querySelector<HTMLElement>('#empty-state');
  const findingList = root?.querySelector<HTMLElement>('#finding-list');
  const summary = root?.querySelector<HTMLElement>('#summary');
  const message = root?.querySelector<HTMLElement>('#scanner-message');
  const inputSize = root?.querySelector<HTMLElement>('#input-size');

  let results: ScanResult[] = [];
  let activeFilter: 'all' | RiskLevel = 'all';

  const setMessage = (value: string) => { if (message) message.textContent = value; };
  const byteSize = (value: string) => new Blob([value]).size;
  const maskSecret = (value: string) => value.length <= 12 ? '••••••••' : `${value.slice(0, 6)}${'•'.repeat(Math.min(18, value.length - 10))}${value.slice(-4)}`;

  function updateInputSize() {
    if (inputSize && input) inputSize.textContent = `${byteSize(input.value).toLocaleString()} BYTES`;
  }

  function clearResults() {
    results = [];
    activeFilter = 'all';
    summary?.setAttribute('hidden', '');
    findingList?.setAttribute('hidden', '');
    exportButton?.setAttribute('hidden', '');
    if (findingList) findingList.replaceChildren();
    if (emptyState) {
      emptyState.removeAttribute('hidden');
      emptyState.querySelector('h3')!.textContent = 'Ready when you are.';
      emptyState.querySelector('p')!.textContent = 'Add source material on the left. Results are pattern matches, not proof that a credential is active.';
    }
  }

  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function addLabeledValue(parent: HTMLElement, label: string, value: string) {
    const item = element('div', 'context-fact');
    item.append(element('span', '', label), element('strong', '', value));
    parent.append(item);
  }

  function buildFinding(result: ScanResult) {
    const card = element('article', `finding risk-${result.risk}`);
    const header = element('header', 'finding-header');
    const titleWrap = element('div');
    const badges = element('div', 'finding-badges');
    badges.append(element('span', `risk-badge ${result.risk}`, `${result.risk.toUpperCase()} · ${result.riskScore}`), element('span', 'location-badge', `LINE ${result.line}:${result.column}`));
    titleWrap.append(badges, element('h3', '', result.displayName), element('p', '', result.description));
    header.append(titleWrap);

    const secretRow = element('div', 'secret-row');
    const secretValue = element('code', '', maskSecret(result.secret));
    const reveal = element('button', 'icon-button', 'REVEAL');
    reveal.type = 'button';
    reveal.setAttribute('aria-label', 'Reveal matched credential');
    let revealed = false;
    reveal.addEventListener('click', () => {
      revealed = !revealed;
      secretValue.textContent = revealed ? result.secret : maskSecret(result.secret);
      reveal.textContent = revealed ? 'MASK' : 'REVEAL';
    });
    const copy = element('button', 'icon-button', 'COPY MASKED');
    copy.type = 'button';
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(maskSecret(result.secret));
        copy.textContent = 'COPIED';
        window.setTimeout(() => { copy.textContent = 'COPY MASKED'; }, 1200);
      } catch { setMessage('Clipboard access was unavailable.'); }
    });
    secretRow.append(secretValue, reveal, copy);

    const details = element('details', 'finding-context');
    const detailsSummary = element('summary');
    detailsSummary.append(element('span', '', 'CONTEXT + RESPONSE'), element('span', '', '⌄'));
    details.append(detailsSummary);

    const detailsBody = element('div', 'context-body');
    const facts = element('div', 'context-facts');
    addLabeledValue(facts, 'ENVIRONMENT', result.environment);
    addLabeledValue(facts, 'EXPOSURE', result.exposure);
    addLabeledValue(facts, 'VARIABLE', result.variableName || 'Not inferred');

    const sourceBlock = element('div', 'source-context');
    const contextLines = [...result.context.before, result.context.matched, ...result.context.after];
    const startLine = result.line - result.context.before.length;
    contextLines.forEach((value, index) => {
      const row = element('div', index === result.context.before.length ? 'matched' : '');
      row.append(element('span', 'line-number', String(startLine + index)), element('code', '', value || ' '));
      sourceBlock.append(row);
    });

    const reasonTitle = element('h4', '', 'WHY IT WAS PRIORITIZED');
    const reasons = element('ul');
    result.riskReasons.forEach(reason => reasons.append(element('li', '', reason)));
    const responseTitle = element('h4', '', result.recommendation.title.toUpperCase());
    const steps = element('ol');
    result.recommendation.steps.forEach(step => steps.append(element('li', '', step)));
    detailsBody.append(facts, sourceBlock, reasonTitle, reasons, responseTitle, steps);
    details.append(detailsBody);

    card.append(header, secretRow, details);
    return card;
  }

  function render() {
    if (!findingList || !summary || !emptyState) return;
    const visible = results.filter(result => activeFilter === 'all' || result.risk === activeFilter);
    findingList.replaceChildren(...visible.map(buildFinding));
    findingList.toggleAttribute('hidden', visible.length === 0);
    emptyState.toggleAttribute('hidden', visible.length > 0);
    if (visible.length === 0) {
      emptyState.querySelector('h3')!.textContent = results.length ? 'No findings in this filter.' : 'No known patterns found.';
      emptyState.querySelector('p')!.textContent = results.length ? 'Choose another severity to continue reviewing.' : 'This is a useful signal, not a guarantee that the source is secret-free.';
    }
  }

  function updateSummary() {
    const counts: Record<'all' | RiskLevel, number> = { all: results.length, critical: 0, high: 0, medium: 0, low: 0 };
    results.forEach(result => { counts[result.risk] += 1; });
    (Object.keys(counts) as Array<keyof typeof counts>).forEach(key => {
      const counter = root?.querySelector<HTMLElement>(`#count-${key}`);
      if (counter) counter.textContent = String(counts[key]);
    });
  }

  function runScan() {
    if (!input || !sourceName || !scanButton) return;
    if (!input.value.trim()) { setMessage('Add text or choose a file first.'); input.focus(); return; }
    if (byteSize(input.value) > MAX_FILE_BYTES) { setMessage('Input exceeds the 2 MB local limit.'); return; }
    scanButton.disabled = true;
    scanButton.textContent = 'SCANNING…';
    window.setTimeout(() => {
      results = scanner.scan(input.value, sourceName.value || 'Pasted text');
      activeFilter = 'all';
      summary?.removeAttribute('hidden');
      exportButton?.toggleAttribute('hidden', results.length === 0);
      root?.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.classList.toggle('active', button.dataset.filter === 'all'));
      updateSummary();
      render();
      setMessage(results.length ? `${results.length} potential finding${results.length === 1 ? '' : 's'} ready for review.` : 'No known credential patterns found.');
      scanButton.disabled = false;
      scanButton.replaceChildren(document.createTextNode('RUN LOCAL SCAN '), element('span', '', '→'));
    }, 80);
  }

  async function loadFile(file: File) {
    if (!input || !sourceName) return;
    if (file.size > MAX_FILE_BYTES) { setMessage('Choose a file smaller than 2 MB.'); return; }
    try {
      input.value = await file.text();
      sourceName.value = file.name;
      updateInputSize();
      clearResults();
      setMessage(`${file.name} loaded locally.`);
    } catch { setMessage('The selected file could not be read.'); }
  }

  await scanner.loadDetectors();
  const audit = scanner.auditDetectors();
  const detectorCount = root?.querySelector<HTMLElement>('#detector-count');
  if (detectorCount) detectorCount.textContent = String(audit.detectorCount);
  setMessage(`${audit.detectorCount} detectors and ${audit.patternCount} patterns ready.`);

  input?.addEventListener('input', () => { updateInputSize(); clearResults(); });
  sourceName?.addEventListener('input', clearResults);
  scanButton?.addEventListener('click', runScan);
  fileButton?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', () => { const file = fileInput.files?.[0]; fileInput.value = ''; if (file) void loadFile(file); });
  exampleButton?.addEventListener('click', () => {
    if (!input || !sourceName) return;
    const github = ['ghp_', 'Ab3d'.repeat(9)].join('');
    const aws = ['AKIA', 'Q7W8E9R0T1Y2U3I4'].join('');
    input.value = `# Synthetic values for interface testing\nNODE_ENV=production\nGITHUB_TOKEN=${github}\nAWS_ACCESS_KEY_ID=${aws}`;
    sourceName.value = 'safe-example.env';
    updateInputSize();
    clearResults();
    setMessage('Synthetic example loaded. Run the local scan when ready.');
  });
  clearButton?.addEventListener('click', () => {
    if (input) input.value = '';
    if (sourceName) sourceName.value = 'Pasted text';
    updateInputSize();
    clearResults();
    setMessage('Workspace cleared.');
  });
  exportButton?.addEventListener('click', () => {
    const safe = results.map(({ secret, ...result }) => ({ ...result, maskedSecret: maskSecret(secret) }));
    const report = JSON.stringify({ generatedAt: new Date().toISOString(), source: sourceName?.value || 'Pasted text', findings: safe }, null, 2);
    const url = URL.createObjectURL(new Blob([report], { type: 'application/json' }));
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = `vuln-management-secret-review-${Date.now()}.json`;
    anchor.click();
    URL.revokeObjectURL(url);
  });
  root?.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
    activeFilter = (button.dataset.filter || 'all') as 'all' | RiskLevel;
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(item => item.classList.toggle('active', item === button));
    render();
  }));
  dropZone?.addEventListener('dragover', event => { event.preventDefault(); dropZone.classList.add('dragging'); });
  dropZone?.addEventListener('dragleave', event => { if (!dropZone.contains(event.relatedTarget as Node | null)) dropZone.classList.remove('dragging'); });
  dropZone?.addEventListener('drop', event => { event.preventDefault(); dropZone.classList.remove('dragging'); const file = event.dataTransfer?.files[0]; if (file) void loadFile(file); });
  window.addEventListener('keydown', event => { if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') { event.preventDefault(); runScan(); } });
</script>

<style>
  .scanner { border: 1px solid var(--line-strong); border-radius: 2px; background: var(--surface); box-shadow: var(--shadow); }
  .scanner-statusbar { display: flex; min-height: 2.5rem; align-items: center; gap: 1.25rem; padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--line); background: var(--surface-solid); color: var(--muted); font: 700 0.6rem var(--mono); letter-spacing: 0.08em; }
  .scanner-statusbar span:first-child { margin-right: auto; }
  .scanner-statusbar i { display: inline-block; width: 0.45rem; height: 0.45rem; margin-right: 0.5rem; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px rgba(22, 101, 52, 0.16); }
  .scanner-statusbar strong { color: var(--signal-dark); }
  .scanner-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.82fr); }
  .scanner-grid.dragging { box-shadow: inset 0 0 0 2px var(--signal); }
  .input-panel { min-width: 0; padding: 1rem; border-right: 1px solid var(--line); }
  .results-panel { min-width: 0; background: var(--surface-raised); }
  .panel-header { display: flex; min-height: 4.5rem; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 0.8rem 0 1rem; }
  .results-panel .panel-header { padding-inline: 1rem; border-bottom: 1px solid var(--line); }
  .panel-index { color: var(--signal-dark); font: 750 0.58rem var(--mono); letter-spacing: 0.1em; }
  .panel-header h2 { margin: 0.2rem 0 0; font-family: var(--serif); font-size: 1.1rem; font-weight: 700; letter-spacing: -0.01em; }
  .privacy-state { padding: 0.25rem 0.45rem; border: 1px solid color-mix(in srgb, var(--signal) 45%, transparent); background: rgba(194, 65, 12, 0.08); color: var(--signal-dark); font: 700 0.55rem var(--mono); letter-spacing: 0.08em; }
  .source-field { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 0.7rem; margin-bottom: 0.6rem; }
  .source-field label { color: var(--muted); font: 700 0.59rem var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .source-field input { min-width: 0; padding: 0.45rem 0.55rem; border: 1px solid var(--line); border-radius: 2px; background: var(--surface-raised); color: var(--ink); font: 0.7rem var(--mono); }
  #scan-input { width: 100%; min-height: 25rem; resize: vertical; padding: 1rem; border: 1px solid var(--line-strong); border-radius: 2px; background: var(--surface-raised); color: var(--ink); font: 0.78rem/1.7 var(--mono); caret-color: var(--signal); }
  #scan-input::placeholder { color: var(--muted); opacity: 0.8; }
  #scan-input:focus { outline: 2px solid var(--signal); outline-offset: 1px; }
  .input-meta { display: flex; justify-content: space-between; gap: 1rem; padding-top: 0.45rem; color: var(--muted); font: 650 0.56rem var(--mono); letter-spacing: 0.06em; }
  .scanner-actions { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.8rem; }
  .scanner-button, .export-button, .icon-button { border: 1px solid var(--line-strong); border-radius: 2px; background: transparent; color: var(--signal-dark); cursor: pointer; font: 750 0.61rem var(--mono); letter-spacing: 0.05em; transition: background 120ms ease, color 120ms ease, border-color 120ms ease; }
  .scanner-button { min-height: 2.55rem; padding: 0.55rem 0.75rem; }
  .scanner-button:hover, .export-button:hover, .icon-button:hover { border-color: var(--signal); background: rgba(194, 65, 12, 0.08); color: var(--signal-dark); }
  .scanner-button.primary { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .scanner-button.primary:hover { border-color: var(--signal-dark); background: var(--signal); color: #fff8ec; }
  .scanner-button.quiet { border-color: transparent; color: var(--muted); }
  .scanner-button:disabled { opacity: 0.45; cursor: not-allowed; }
  .privacy-note { margin: 0.85rem 0 0; padding: 0.65rem 0.75rem; border-left: 3px solid var(--signal); background: rgba(194, 65, 12, 0.07); color: var(--muted); font-size: 0.7rem; line-height: 1.55; }
  .privacy-note strong { color: var(--signal-dark); }
  .export-button { padding: 0.45rem 0.6rem; font-size: 0.55rem; }
  .summary { display: grid; grid-template-columns: repeat(5, 1fr); border-bottom: 1px solid var(--line); }
  .summary button { min-width: 0; padding: 0.7rem 0.2rem; border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; }
  .summary button:last-child { border-right: 0; }
  .summary button.active { background: rgba(194, 65, 12, 0.1); color: var(--signal-dark); }
  .summary strong, .summary span { display: block; }
  .summary strong { font: 800 1rem var(--mono); }
  .summary span { margin-top: 0.1rem; font: 700 0.48rem var(--mono); letter-spacing: 0.07em; }
  .empty-state { display: grid; min-height: 31rem; place-content: center; padding: 2rem; text-align: center; }
  .empty-icon { color: var(--signal); font: 3rem var(--mono); }
  .empty-state h3 { margin: 0.6rem 0 0; font-family: var(--serif); font-size: 1.15rem; }
  .empty-state p { max-width: 24rem; margin: 0.45rem auto 0; color: var(--muted); font-size: 0.72rem; line-height: 1.55; }
  .finding-list { max-height: 43rem; padding: 0.65rem; overflow-y: auto; }
  .finding { margin-bottom: 0.55rem; padding: 0.85rem; border: 1px solid var(--line-strong); border-radius: 2px; background: var(--surface); }
  .finding.risk-critical { border-left: 3px solid var(--alert); }
  .finding.risk-high { border-left: 3px solid var(--signal); }
  .finding.risk-medium { border-left: 3px solid var(--acid); }
  .finding.risk-low { border-left: 3px solid #0369a1; }
  .finding-header { display: flex; justify-content: space-between; gap: 1rem; }
  .finding-badges { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .risk-badge, .location-badge { padding: 0.2rem 0.4rem; border: 1px solid var(--line); border-radius: 2px; color: var(--muted); font: 750 0.52rem var(--mono); letter-spacing: 0.05em; }
  .risk-badge.critical { border-color: color-mix(in srgb, var(--alert) 55%, transparent); color: var(--alert); }
  .risk-badge.high { border-color: color-mix(in srgb, var(--signal) 55%, transparent); color: var(--signal-dark); }
  .risk-badge.medium { color: var(--acid); }
  .risk-badge.low { color: #0369a1; }
  .finding h3 { margin: 0.6rem 0 0; color: var(--ink); font-family: var(--serif); font-size: 0.95rem; font-weight: 700; }
  .finding-header p { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.67rem; }
  .secret-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 0.35rem; margin-top: 0.75rem; padding: 0.45rem; border: 1px solid var(--line); border-radius: 2px; background: var(--surface-solid); }
  .secret-row code { min-width: 0; overflow: hidden; color: var(--ink); font-size: 0.68rem; text-overflow: ellipsis; white-space: nowrap; }
  .icon-button { padding: 0.3rem 0.4rem; font-size: 0.48rem; }
  .finding-context { margin-top: 0.65rem; border: 1px solid var(--line); border-radius: 2px; }
  .finding-context summary { display: flex; justify-content: space-between; padding: 0.55rem 0.65rem; color: var(--muted); font: 750 0.56rem var(--mono); letter-spacing: 0.06em; list-style: none; }
  .context-body { padding: 0.75rem; border-top: 1px solid var(--line); }
  .context-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem; }
  .context-fact { min-width: 0; padding: 0.5rem; border: 1px solid var(--line); background: var(--surface-raised); }
  .context-fact span, .context-fact strong { display: block; overflow: hidden; text-overflow: ellipsis; }
  .context-fact span { color: var(--muted); font: 700 0.48rem var(--mono); }
  .context-fact strong { margin-top: 0.2rem; color: var(--ink); font-size: 0.63rem; }
  .source-context { margin-top: 0.65rem; padding-block: 0.35rem; overflow-x: auto; border: 1px solid var(--line); border-radius: 2px; background: var(--surface-solid); }
  .source-context > div { display: flex; min-width: max-content; padding-inline: 0.55rem; color: var(--muted); font: 0.6rem/1.7 var(--mono); }
  .source-context > div.matched { background: rgba(194, 65, 12, 0.1); color: var(--ink); }
  .line-number { width: 2rem; margin-right: 0.65rem; color: var(--muted); opacity: 0.7; text-align: right; user-select: none; }
  .context-body h4 { margin: 0.8rem 0 0.3rem; color: var(--signal-dark); font: 750 0.55rem var(--mono); letter-spacing: 0.06em; }
  .context-body ul, .context-body ol { margin: 0; padding-left: 1.2rem; color: var(--muted); font-size: 0.65rem; line-height: 1.55; }
  .scanner-footnote { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0.8rem; border-top: 1px solid var(--line); background: var(--surface-solid); color: var(--muted); font: 650 0.56rem var(--mono); letter-spacing: 0.05em; }
  [hidden] { display: none !important; }

  @media (max-width: 900px) {
    .scanner-grid { grid-template-columns: 1fr; }
    .input-panel { border-right: 0; border-bottom: 1px solid var(--line); }
    .finding-list { max-height: none; }
  }

  @media (max-width: 560px) {
    .scanner-statusbar span:nth-child(n + 2) { display: none; }
    .panel-header { align-items: center; }
