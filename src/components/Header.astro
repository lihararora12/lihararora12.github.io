---
const path = Astro.url.pathname;
const links = [
  { href: '/advisories/', label: 'Advisories', sup: 'CVE' },
  { href: '/scanner/', label: 'Scanner', sup: 'TRY' },
  { href: '/posts/', label: 'Posts', sup: 'READ' },
  { href: '/memes/', label: 'Memes', sup: 'LOL' },
  { href: '/about/', label: 'About', sup: 'WHO' },
];
---

<header class="command-bar">
  <nav class="pill-nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="vuln.management home">
      <img src="/images/favicon.webp" alt="" width="34" height="34" class="brand-mark" />
      <span class="brand-word">vuln<em>.management</em></span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">
      Menu
    </button>
    <div class="nav-links" id="nav-links">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}<sup>{link.sup}</sup>
        </a>
      ))}
      <a href="/scanner/" class="nav-cta">Run the scanner</a>
    </div>
  </nav>
</header>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const navLinks = document.querySelector<HTMLElement>('#nav-links');
  navToggle?.addEventListener('click', () => {
    const open = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', String(!open));
    navLinks?.classList.toggle('open', !open);
  });
</script>

<style>
  .command-bar {
    position: sticky;
    top: 0.9rem;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
  }

  .pill-nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.5rem 0.45rem 0.7rem;
    border-radius: 999px;
    background: rgba(8, 11, 22, 0.72);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 18px 50px -12px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    padding-right: 0.6rem;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    box-shadow: 0 0 18px rgba(255, 106, 26, 0.55);
  }

  .brand-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  .brand-word em {
    font-style: normal;
    color: var(--orange);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .nav-links a:not(.nav-cta) {
    position: relative;
    padding: 0.6rem 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.18s, background 0.18s;
  }
  .nav-links a:not(.nav-cta) sup {
    font-size: 0.55em;
    color: var(--faint);
    margin-left: 0.35em;
    letter-spacing: 0.06em;
  }
  .nav-links a:not(.nav-cta):hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-links a:not(.nav-cta):hover sup { color: var(--orange); }
  .nav-links a[aria-current='page'] {
    color: var(--ink);
    background: rgba(255, 106, 26, 0.14);
  }
  .nav-links a[aria-current='page'] sup { color: var(--orange); }

  .nav-cta {
    margin-left: 0.4rem;
    padding: 0.62rem 1.15rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--orange-hot), var(--orange));
    color: #140800;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 6px 22px -6px rgba(255, 106, 26, 0.7);
    transition: transform 0.18s, box-shadow 0.22s;
    white-space: nowrap;
  }
  .nav-cta:hover { transform: scale(1.05); box-shadow: 0 10px 30px -6px rgba(255, 106, 26, 0.85); }

  .nav-toggle {
    display: none;
    border: 1px solid var(--hairline);
    background: rgba(255, 255, 255, 0.05);
    color: var(--ink);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .command-bar { top: 0.6rem; }
    .pill-nav { flex-wrap: wrap; border-radius: 24px; width: 100%; justify-content: space-between; }
    .nav-toggle { display: block; }
    .nav-links {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      padding: 0.4rem 0.2rem 0.3rem;
    }
    .nav-links.open { display: flex; }
    .nav-links a:not(.nav-cta) { text-align: left; padding: 0.7rem 0.9rem; }
    .nav-cta { margin: 0.3rem 0 0; text-align: center; }
  }
</style>
