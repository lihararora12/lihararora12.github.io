---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdvisoryCard from '../components/AdvisoryCard.astro';
import { isPublished, newestPostsFirst, newestAdvisoriesFirst } from '../lib/content';
import { DETECTORS } from '../lib/secret-scanner/detectors';

const posts = (await getCollection('posts')).filter(isPublished).sort(newestPostsFirst);
const advisories = (await getCollection('advisories')).filter(isPublished).sort(newestAdvisoriesFirst);
const detectorCount = DETECTORS.length;

// Patch forecast: weather-style read on the last 14 days of advisories.
const now = new Date();
const DAY = 86_400_000;
const recentAdvisories = advisories.filter(
  (a) => now.getTime() - a.data.advisoryDate.getTime() < 14 * DAY,
);
const actNowCount = recentAdvisories.filter((a) => a.data.priority === 'act-now').length;
const kevCount = recentAdvisories.filter((a) => a.data.kev).length;
const highCount = recentAdvisories.filter((a) => a.data.priority === 'high').length;
const condition = actNowCount > 0 || kevCount > 0 ? 'STORMY' : highCount > 0 ? 'ELEVATED' : 'CALM';
const conditionCopy = {
  STORMY: 'Known-exploited vulnerabilities are in the wild. Patch like it is raining.',
  ELEVATED: 'High-priority advisories are stacking up. Keep the umbrella within reach.',
  CALM: 'No fires on the board this week. Enjoy it; it will not last.',
}[condition];

const weekBars = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(now.getTime() - (6 - i) * DAY);
  const key = d.toISOString().slice(0, 10);
  const count = advisories.filter((a) => a.data.advisoryDate.toISOString().slice(0, 10) === key).length;
  return {
    label: d.toLocaleDateString('en-US', { weekday: 'narrow', timeZone: 'UTC' }),
    full: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }),
    count,
  };
});
const maxBar = Math.max(1, ...weekBars.map((b) => b.count));
const forecastDate = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Vulnerability management / AI / agents</p>
      <h1 class="display">Security Is All About <em>Context</em></h1>
      <p class="lede">
        Practical security thinking for systems that increasingly write, deploy, and operate themselves. Fewer buzzwords. Better evidence. Occasional memes.
      </p>
      <div class="hero-actions">
        <a class="button" href="/advisories/">Check advisories</a>
        <a class="button secondary" href="/scanner/">Secret Scanner</a>
      </div>
    </div>

    <aside class="signal-panel" aria-label="Current site signal">
      <header><span>NEWSROOM WIRE</span><span class="online">ONLINE</span></header>
      <dl>
        <div><dt>Scope</dt><dd>AI × vulnerability management</dd></div>
        <div><dt>Priority</dt><dd>Evidence over vibes</dd></div>
        <div><dt>Backlog</dt><dd>Still undefeated</dd></div>
      </dl>
      <footer>NO CRITICAL PIE CHARTS DETECTED</footer>
    </aside>
  </section>

  <div class="inventory">
    <div class="shell">
      <span><strong>{advisories.length}</strong> advisories</span>
      <span><strong>{posts.length}</strong> posts</span>
      <span><strong>39</strong> memes</span>
      <span><strong>{detectorCount}</strong> secret detectors</span>
      <span class="inventory-status">Status: context required</span>
    </div>
  </div>

  <section class="forecast shell" aria-labelledby="forecast-heading">
    <div class="forecast-main">
      <p class="eyebrow">Patch forecast / updated {forecastDate}</p>
      <p class="forecast-condition" data-condition={condition.toLowerCase()} id="forecast-heading">{condition}</p>
      <p class="forecast-copy">{conditionCopy}</p>
      <p class="forecast-meta">
        <span><strong>{recentAdvisories.length}</strong> advisories in 14 days</span>
        <span><strong>{kevCount}</strong> known-exploited</span>
        <span><strong>{actNowCount}</strong> act-now</span>
      </p>
    </div>
    <div class="forecast-week" role="img" aria-label={`Advisories published per day over the last 7 days, ending ${forecastDate}`}>
      {weekBars.map((b) => (
        <div class="forecast-day">
          <span class="forecast-count">{b.count > 0 ? b.count : ''}</span>
          <div class="forecast-bar" style={`--h: ${(b.count / maxBar * 100).toFixed(0)}%`} title={`${b.full}: ${b.count} advisories`}></div>
          <span class="forecast-label">{b.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section advisory-zone">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow">Advisory desk</p>
          <h2>Known exploitation already skipped the prioritization meeting.</h2>
        </div>
        <a class="text-link" href="/advisories/">All advisories</a>
      </div>
      <div class="card-grid">
        {advisories.slice(0, 3).map((entry) => <AdvisoryCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="tool-band shell" aria-labelledby="scanner-heading">
    <div>
      <p class="eyebrow">Browser tool / no upload</p>
      <h2 id="scanner-heading">Find leaked secrets without leaking them.</h2>
      <p>Paste code, config, or logs. {detectorCount} detectors run entirely in your browser and return redacted findings, reasoned risk scores, and rotation guidance. Nothing uploads. Nothing phones home.</p>
    </div>
    <div class="tool-console" aria-hidden="true">
      <span>SCAN_MODE</span><strong>LOCAL_ONLY</strong>
      <span>DETECTORS</span><strong>{detectorCount}</strong>
      <span>NETWORK</span><strong class="safe">DISABLED</strong>
    </div>
    <a class="button" href="/scanner/">Open scanner</a>
  </section>

  <section class="section section-rule shell" aria-labelledby="latest-posts">
    <div class="section-head">
      <div>
        <p class="eyebrow">Latest posts</p>
        <h2 id="latest-posts">For the work after the scanner finishes yelling.</h2>
      </div>
      <a class="text-link" href="/posts/">All posts</a>
    </div>
    <div class="card-grid">
      {posts.slice(0, 3).map((entry, index) => <PostCard entry={entry} index={index} />)}
    </div>
  </section>

  <section class="meme-band shell">
    <div class="meme-frame" aria-hidden="true">
      <img src="/images/photos/memes-24.jpg" alt="" loading="lazy" />
    </div>
    <div>
      <p class="eyebrow">Compensating control</p>
      <h2>When remediation is blocked, deploy humor.</h2>
      <a class="button secondary" href="/memes/">Open the meme archive</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.55fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    overflow: clip;
  }

  .hero::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 88% 6%, rgba(194, 65, 12, 0.12), transparent 24rem),
      radial-gradient(circle at 4% 92%, rgba(180, 83, 9, 0.08), transparent 20rem);
    pointer-events: none;
    content: "";
  }

  .hero .display em { display: block; }
  .hero .display {
    max-width: 14ch;
    font-size: clamp(3rem, 6.6vw, 6rem);
    letter-spacing: -0.03em;
    line-height: 0.96;
    text-wrap: balance;
  }
  .hero-copy { position: relative; min-width: 0; }
  .hero .lede { margin: 1.6rem 0 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.8rem; }

  .signal-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .signal-panel::before {
    position: absolute;
    top: -1px;
    left: 0.8rem;
    width: 3.5rem;
    height: 3px;
    background: var(--signal);
    content: "";
  }

  .signal-panel header,
  .signal-panel footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.8rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface-solid);
    color: var(--muted);
    font: 700 0.61rem var(--mono);
    letter-spacing: 0.08em;
  }

  .signal-panel footer { justify-content: flex-start; border-top: 1px solid var(--line); border-bottom: 0; }
  .online { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--ok); }
  .online::before { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px rgba(22, 101, 52, 0.16); content: ""; }
  .signal-panel dl { margin: 0; padding: 0.5rem 0.8rem; }
  .signal-panel dl div { display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
  .signal-panel dl div:last-child { border-bottom: 0; }
  .signal-panel dt { color: var(--signal-dark); font: 700 0.62rem var(--mono); text-transform: uppercase; }
  .signal-panel dd { margin: 0; font-size: 0.86rem; font-weight: 650; }

  .inventory { border-block: 3px double var(--line-strong); background: var(--surface-solid); }
  .inventory .shell { display: flex; min-height: 3.6rem; align-items: center; gap: 2rem; color: var(--muted); font: 650 0.67rem var(--mono); text-transform: uppercase; }
  .inventory strong { color: var(--ink); font-size: 0.88rem; }
  .inventory-status { margin-left: auto; color: var(--ok); }

  .forecast {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .forecast-condition {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 5.5vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .forecast-condition[data-condition="stormy"] { color: var(--alert); }
  .forecast-condition[data-condition="elevated"] { color: var(--acid); }
  .forecast-condition[data-condition="calm"] { color: var(--ok); }

  .forecast-copy { max-width: 34rem; margin: 0.9rem 0 0; color: var(--ink); font-family: var(--serif); font-size: 1.05rem; font-style: italic; }
  .forecast-meta { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; margin: 1rem 0 0; color: var(--muted); font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase; }
  .forecast-meta strong { color: var(--signal-dark); font-size: 0.85rem; }

  .forecast-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.5rem; align-self: stretch; }
  .forecast-day { display: flex; min-height: 9rem; flex-direction: column; align-items: center; justify-content: flex-end; gap: 0.35rem; }
  .forecast-count { min-height: 1rem; color: var(--signal-dark); font-family: var(--mono); font-size: 0.66rem; font-weight: 700; }
  .forecast-bar {
    width: 100%;
    max-width: 2.2rem;
    height: var(--h);
    min-height: 0.25rem;
    border-radius: 1px 1px 0 0;
    background: var(--signal);
    opacity: 0.85;
  }
  .forecast-label { color: var(--muted); font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; }

  .advisory-zone { background: var(--paper-deep); border-block: 3px double var(--line-strong); }
  .advisory-zone .section-head { margin-bottom: 2rem; }

  .tool-band {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(14rem, 0.55fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-block: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .tool-band h2 { max-width: 22ch; margin: 0; font-family: var(--serif); font-size: clamp(1.7rem, 3vw, 2.7rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.04; }
  .tool-band p:not(.eyebrow) { max-width: 43rem; margin: 0.8rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .tool-console { display: grid; grid-template-columns: auto auto; gap: 0.45rem 1rem; color: var(--muted); font: 700 0.62rem var(--mono); }
  .tool-console strong { color: var(--ink); text-align: right; }
  .tool-console .safe { color: var(--ok); }

  .meme-band {
    display: grid;
    grid-template-columns: 14rem 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    margin-block: clamp(4rem, 8vw, 7rem);
    padding: 1.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .meme-frame { max-height: 13rem; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 2px; background: var(--paper); transform: rotate(-1deg); }
  .meme-frame img { width: 100%; height: 13rem; object-fit: cover; }
  .meme-band h2 { max-width: 23ch; margin: 0 0 1.3rem; font-family: var(--serif); font-size: clamp(1.7rem, 3vw, 2.8rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; }

  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; }
    .signal-panel { max-width: 32rem; }
    .forecast { grid-template-columns: 1fr; }
    .forecast-week { max-width: 26rem; }
    .forecast-day { min-height: 7rem; }
    .tool-band { grid-template-columns: 1fr; }
    .tool-console { max-width: 20rem; }
    .tool-band .button { width: max-content; }
  }

  @media (max-width: 600px) {
    .hero .display { max-width: 15ch; font-size: clamp(2.2rem, 11vw, 3.2rem); }
    .inventory .shell { flex-wrap: wrap; gap: 0.65rem 1.2rem; padding-block: 0.8rem; }
    .inventory-status { width: 100%; margin-left: 0; }
    .meme-band { grid-template-columns: 1fr; }
    .meme-frame { display: none; }
  }
</style>
