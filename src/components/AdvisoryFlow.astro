---
interface FlowStep {
  label: string;
  detail: string;
}

interface Props {
  eli5: string;
  flow: FlowStep[];
}

const { eli5, flow } = Astro.props;
---

<section class="advisory-explainer" aria-label="Plain-language and visual explanation">
  <div class="eli5">
    <span>ELI5</span>
    <div>
      <h2>Explain it like I’m five</h2>
      <p>{eli5}</p>
    </div>
  </div>

  <div class="flow-panel">
    <div class="flow-header">
      <span>SIMPLIFIED_ATTACK_PATH</span>
      <span>{String(flow.length).padStart(2, '0')} STEPS</span>
    </div>
    <ol class="flow">
      {flow.map((step, index) => (
        <li>
          <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
          <strong>{step.label}</strong>
          <p>{step.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .advisory-explainer {
    display: grid;
    gap: 1.1rem;
    padding-block: 2.2rem;
  }

  .eli5 {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.2rem;
    padding: 1.2rem;
    border: var(--bd);
    border-radius: var(--radius);
    background: var(--mustard-soft);
    box-shadow: var(--shadow-hard-sm);
    transform: rotate(-0.4deg);
  }
  .eli5 > span {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-content: center;
    border: var(--bd-thin);
    border-radius: 12px;
    background: var(--mustard);
    color: var(--ink);
    font: 400 0.72rem var(--font-display);
    letter-spacing: 0.04em;
    transform: rotate(-4deg);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .eli5 h2 { margin: 0 0 0.35rem; font-family: var(--font-display); font-size: 1.2rem; }
  .eli5 p { max-width: 50rem; margin: 0; color: var(--muted); font-weight: 600; line-height: 1.6; }

  .flow-panel {
    overflow: hidden;
    border: var(--bd);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow-hard-sm);
  }
  .flow-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.1rem;
    background: var(--ink);
    color: var(--paper);
    font: 700 0.64rem var(--font-mono);
    letter-spacing: 0.12em;
  }
  .flow-header span:last-child { color: var(--mustard); }
  .flow { list-style: none; margin: 0; padding: 1.1rem; display: grid; gap: 0.8rem; }
  .flow li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 1rem;
    padding: 1rem 1.1rem;
    border: var(--bd-thin);
    border-radius: 10px;
    background: var(--paper);
  }
  .flow li:nth-child(odd) { transform: rotate(0.3deg); }
  .flow li:nth-child(even) { transform: rotate(-0.3deg); }
  .step-number {
    grid-row: span 2;
    display: grid;
    place-content: center;
    width: 2.6rem; height: 2.6rem;
    background: var(--tomato);
    color: #fff8ee;
    border: var(--bd-thin);
    border-radius: 50%;
    font: 400 0.9rem var(--font-display);
    box-shadow: 2px 2px 0 var(--ink);
    transform: rotate(-5deg);
  }
  .flow strong { font-family: var(--font-display); font-size: 1rem; font-weight: 400; }
  .flow p { margin: 0; color: var(--muted); font-size: 0.88rem; font-weight: 600; line-height: 1.55; }
</style>
