---
import BaseLayout from '../../layouts/BaseLayout.astro';

const memes = Array.from({ length: 39 }, (_, index) => ({
  index: index + 1,
  src: `/images/photos/memes-${index + 1}.jpg`,
}));
---

<BaseLayout
  title="Cybersecurity memes — vuln.management"
  description="The original vuln.management cybersecurity meme archive. Thirty-nine artifacts and counting."
>
  <section class="section shell" aria-labelledby="archive-heading">
    <div class="section-head">
      <h1 id="archive-heading">Archive</h1>
      <div class="archive-actions">
        <span class="tag">39 artifacts</span>
        <button class="button secondary" id="randomize" type="button">Random meme</button>
      </div>
    </div>

    <div class="meme-grid">
      {memes.map((meme) => (
        <button class="meme-card" type="button" data-src={meme.src} data-index={meme.index} aria-label={`Open cybersecurity meme ${meme.index}`}>
          <img src={meme.src} alt={`Cybersecurity meme ${meme.index}`} loading="lazy" />
          <span>Artifact {String(meme.index).padStart(2, '0')}</span>
        </button>
      ))}
    </div>
  </section>

  <dialog class="meme-dialog" id="meme-dialog" aria-label="Expanded meme">
    <button class="dialog-close" id="dialog-close" type="button" aria-label="Close expanded meme">Close ×</button>
    <img id="dialog-image" src="" alt="Expanded cybersecurity meme" />
    <p id="dialog-label"></p>
  </dialog>
</BaseLayout>

<script>
  const total = 39;
  const dialog = document.querySelector<HTMLDialogElement>('#meme-dialog');
  const dialogImage = document.querySelector<HTMLImageElement>('#dialog-image');
  const dialogLabel = document.querySelector<HTMLElement>('#dialog-label');

  const openMeme = (index: number, src = `/images/photos/memes-${index}.jpg`) => {
    if (dialogImage) dialogImage.src = src;
    if (dialogLabel) dialogLabel.textContent = `Artifact ${String(index).padStart(2, '0')} / ${total}`;
    dialog?.showModal();
  };

  document.querySelector('#randomize')?.addEventListener('click', () => {
    openMeme(Math.floor(Math.random() * total) + 1);
  });

  document.querySelectorAll<HTMLButtonElement>('.meme-card').forEach((card) => {
    card.addEventListener('click', () => {
      const src = card.dataset.src;
      const index = card.dataset.index;
      if (src && index) openMeme(Number(index), src);
    });
  });

  document.querySelector('#dialog-close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .archive-actions { display: flex; align-items: center; gap: 0.7rem; }

  .meme-grid { columns: 4 15rem; column-gap: 1rem; }
  .meme-card { position: relative; width: 100%; margin: 0 0 1rem; padding: 0; overflow: hidden; break-inside: avoid; border: 1px solid var(--line); border-radius: 0.35rem; background: var(--surface); color: var(--ink); cursor: zoom-in; text-align: left; transition: transform 140ms ease, border 140ms ease, box-shadow 140ms ease; }
  .meme-card:hover { border-color: var(--line-strong); box-shadow: var(--shadow); transform: translateY(-3px); }
  .meme-card img { width: 100%; }
  .meme-card span { display: block; padding: 0.65rem 0.75rem; color: var(--muted); font: 700 0.62rem var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }

  .meme-dialog { width: min(92vw, 62rem); max-height: 92vh; padding: 3.5rem 1rem 1rem; overflow: auto; border: 1px solid var(--line-strong); border-radius: 0.35rem; background: var(--surface-solid); color: var(--ink); box-shadow: 0 30px 100px rgba(0, 0, 0, 0.5); }
  .meme-dialog::backdrop { background: rgba(5, 8, 6, 0.82); backdrop-filter: blur(8px); }
  .meme-dialog img { max-height: 74vh; margin: 0 auto; object-fit: contain; }
  .meme-dialog p { margin: 0.7rem 0 0; color: var(--muted); font: 700 0.65rem var(--mono); text-align: center; text-transform: uppercase; }
  .dialog-close { position: absolute; top: 0.75rem; right: 0.75rem; padding: 0.45rem 0.7rem; border: 1px solid var(--line); border-radius: 0.2rem; background: var(--paper); color: var(--ink); cursor: pointer; font: 700 0.7rem var(--mono); text-transform: uppercase; }

</style>
