---
const path = Astro.url.pathname;
const links = [
  { href: '/advisories/', label: 'Advisories' },
  { href: '/scanner/', label: 'Secret Scanner' },
  { href: '/posts/', label: 'Posts' },
  { href: '/memes/', label: 'Memes' },
  { href: '/about/', label: 'About' },
];

const today = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/Los_Angeles',
});
---

<header class="masthead">
  <div class="shell dateline">
    <span>{today}</span>
    <span class="dateline-right">Late edition · No tracking · No ads</span>
  </div>
  <div class="shell nameplate">
    <a class="nameplate-link" href="/" aria-label="vuln.management home">
      <span class="nameplate-mark" aria-hidden="true">VM</span>
      <span class="nameplate-word">vuln.management</span>
    </a>
    <p class="nameplate-tagline">Vulnerability management for the agentic era</p>
  </div>
  <nav class="section-nav" aria-label="Primary navigation">
    <div class="shell section-nav-inner">
      <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">
        Sections
      </button>
      <div class="nav-links" id="nav-links">
        {links.map((link) => (
          <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const navLinks = document.querySelector<HTMLElement>('#nav-links');
  navToggle?.addEventListener('click', () => {
    const open = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', String(!open));
    navLinks?.classList.toggle('open', !open);
  });
</script>

<style>
  .masthead {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
  }

  .dateline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nameplate {
    padding-block: 2.2rem 1.6rem;
    text-align: center;
  }

  .nameplate-link {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
  }

  .nameplate-mark {
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    flex: 0 0 auto;
    place-content: center;
    border: 2px solid var(--ink);
    background: var(--signal);
    color: #fff8ec;
    font-family: var(--mono);
    font-size: 1.05rem;
    font-weight: 700;
    transform: rotate(-4deg);
  }

  .nameplate-word {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .nameplate-tagline {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.05rem;
    font-style: italic;
  }

  .section-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-top: 3px double var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(14px);
  }

  .section-nav-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-links {
    display: flex;
    align-items: stretch;
    gap: 0.15rem;
  }

  .nav-links a {
    padding: 0.8rem 1.05rem;
    border-left: 1px solid transparent;
    border-right: 1px solid transparent;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 120ms ease, background 120ms ease;
  }

  .nav-links a:hover { background: var(--surface); color: var(--ink); }

  .nav-links a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }

  .nav-toggle {
    display: none;
    width: 100%;
    padding: 0.8rem 0.5rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .dateline-right { display: none; }
    .nameplate { padding-block: 1.6rem 1.2rem; }
    .nameplate-mark { width: 2.4rem; height: 2.4rem; font-size: 0.8rem; }
    .section-nav-inner { display: block; }
    .nav-toggle { display: block; }
    .nav-links { display: none; flex-direction: column; border-top: 1px solid var(--line); }
    .nav-links.open { display: flex; }
    .nav-links a { border: 0; border-top: 1px solid var(--line); text-align: center; }
  }
</style>
