---
const path = Astro.url.pathname;
const links = [
  { href: '/advisories/', label: 'Advisories' },
  { href: '/posts/', label: 'Posts' },
  { href: '/memes/', label: 'Memes' },
  { href: '/about/', label: 'About' },
  { href: '/scanner/', label: 'Secret Scanner' },
];
---

<header class="zine-bar">
  <nav class="zine-nav section-shell" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="vuln.management home">
      <img src="/images/favicon.svg" alt="" width="38" height="38" class="brand-mark" />
      <span class="brand-word">vuln<em>.management</em></span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">
      Menu
    </button>
    <div class="nav-links" id="nav-links">
      {links.map((link) => (
        <a
          href={link.href}
          class="nav-tab"
          aria-current={path.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const navLinks = document.querySelector<HTMLElement>('#nav-links');
  navToggle?.addEventListener('click', () => {
    const open = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', String(!open));
    navLinks?.classList.toggle('open', !open);
  });
</script>

<style>
  .zine-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: var(--bd);
  }
  .zine-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.7rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-right: auto;
    transform: rotate(-1deg);
    transition: transform 0.18s;
  }
  .brand:hover { transform: rotate(1deg) scale(1.03); }
  .brand-mark {
    width: 38px; height: 38px;
    filter: drop-shadow(2px 2px 0 var(--ink));
  }
  .brand-word {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .brand-word em { font-style: normal; color: var(--tomato-deep); }

  .nav-links { display: flex; align-items: center; gap: 0.55rem; }

  .nav-tab {
    padding: 0.5rem 0.95rem;
    border: 2px solid transparent;
    border-radius: 999px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.15s;
  }
  .nav-tab:hover {
    background: var(--mustard-soft);
    border-color: var(--ink);
    transform: rotate(-1.5deg);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .nav-tab[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
    transform: rotate(1deg);
  }


  .nav-toggle {
    display: none;
    padding: 0.55rem 1rem;
    border: var(--bd-thin);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 2px 2px 0 var(--ink);
  }

  @media (max-width: 860px) {
    .zine-nav { flex-wrap: wrap; }
    .nav-toggle { display: block; }
    .nav-links {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      padding: 0.6rem 0 0.2rem;
    }
    .nav-links.open { display: flex; }
    .nav-tab { text-align: left; border-color: var(--line); }
  }
</style>
