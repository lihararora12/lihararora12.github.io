---
import BaseLayout from '../../layouts/BaseLayout.astro';

const memes = Array.from({ length: 39 }, (_, index) => ({
  index: index + 1,
  src: `/images/photos/memes-${index + 1}.jpg`,
}));
---

<BaseLayout
  title="Cybersecurity memes — vuln.management"
  description="The original vuln.management cybersecurity meme archive. Thirty-nine artifacts and counting."
>
  <section class="section shell" aria-labelledby="archive-heading">
    <div class="section-head">
      <h1 id="archive-heading">Archive</h1>
      <div class="archive-actions">
        <span class="tag">39 artifacts</span>
        <button class="button secondary" id="randomize" type="button">Random meme</button>
      </div>
    </div>

    <div class="meme-grid">
      {memes.map((meme) => (
        <button class="meme-card" type="button" data-src={meme.src} data-index={meme.index} aria-label={`Open cybersecurity meme ${meme.index}`}>
          <img src={meme.src} alt={`Cybersecurity meme ${meme.index}`} loading="lazy" />
          <span>Artifact {String(meme.index).padStart(2, '0')}</span>
        </button>
      ))}
    </div>
  </section>

  <dialog class="meme-dialog" id="meme-dialog" aria-label="Expanded meme">
    <button class="dialog-close" id="dialog-close" type="button" aria-label="Close expanded meme">Close ×</button>
    <img id="dialog-image" src="" alt="Expanded cybersecurity meme" />
    <p id="dialog-label"></p>
  </dialog>
</BaseLayout>

<script>
  const total = 39;
  const dialog = document.querySelector<HTMLDialogElement>('#meme-dialog');
  const dialogImage = document.querySelector<HTMLImageElement>('#dialog-image');
  const dialogLabel = document.querySelector<HTMLElement>('#dialog-label');

  const openMeme = (index: number, src = `/images/photos/memes-${index}.jpg`) => {
    if (dialogImage) dialogImage.src = src;
    if (dialogLabel) dialogLabel.textContent = `Artifact ${String(index).padStart(2, '0')} / ${total}`;
    dialog?.showModal();
  };

  document.querySelector('#randomize')?.addEventListener('click', () => {
    openMeme(Math.floor(Math.random() * total) + 1);
  });

  document.querySelectorAll<HTMLButtonElement>('.meme-card').forEach((card) => {
    card.addEventListener('click', () => {
      const src = card.dataset.src;
      const index = card.dataset.index;
      if (src && index) openMeme(Number(index), src);
    });
  });

  document.querySelector('#dialog-close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .archive-actions { display: flex; align-items: center; gap: 0.7rem; }

  .meme-grid { columns: 4 15rem; column-gap: 1.4rem; }
  .meme-card {
    position: relative;
    width: 100%;
    margin: 0 0 1.6rem;
    padding: 0.7rem 0.7rem 0.6rem;
    break-inside: avoid;
    border: var(--bd-thin);
    background: #fff;
    color: var(--ink);
    cursor: zoom-in;
    text-align: left;
    box-shadow: var(--shadow-hard-sm);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .meme-card:nth-child(3n+1) { transform: rotate(-1.4deg); }
  .meme-card:nth-child(3n+2) { transform: rotate(1.1deg); }
  .meme-card:nth-child(3n) { transform: rotate(-0.5deg); }
  .meme-card::before {
    content: "";
    position: absolute;
    top: -13px; left: 50%;
    width: 84px; height: 26px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(242, 176, 30, 0.72);
    border-left: 2px dashed rgba(30, 24, 17, 0.4);
    border-right: 2px dashed rgba(30, 24, 17, 0.4);
    z-index: 2;
  }
  .meme-card:nth-child(2n)::before { background: rgba(224, 101, 154, 0.6); transform: translateX(-50%) rotate(4deg); }
  .meme-card:hover { box-shadow: var(--shadow-hard); transform: rotate(0deg) translate(-2px, -2px) scale(1.02); z-index: 3; }
  .meme-card img { width: 100%; border: 2px solid var(--ink); display: block; }
  .meme-card span {
    display: block;
    padding: 0.6rem 0.4rem 0.2rem;
    color: var(--muted);
    font: 700 0.62rem var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }

  .meme-dialog {
    width: min(92vw, 62rem);
    max-height: 92vh;
    padding: 3.5rem 1.2rem 1.2rem;
    overflow: auto;
    border: var(--bd);
    border-radius: 16px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-hard-lg);
  }
  .meme-dialog::backdrop { background: rgba(30, 24, 17, 0.55); backdrop-filter: blur(6px); }
  .meme-dialog img { max-height: 72vh; margin: 0 auto; object-fit: contain; border: var(--bd); box-shadow: var(--shadow-hard-sm); display: block; }
  .meme-dialog p { margin: 0.9rem 0 0; color: var(--muted); font: 700 0.65rem var(--mono); letter-spacing: 0.1em; text-align: center; text-transform: uppercase; }
  .dialog-close {
    position: absolute;
    top: 0.9rem; right: 0.9rem;
    padding: 0.5rem 0.8rem;
    border: var(--bd-thin);
    border-radius: 999px;
    background: var(--tomato);
    color: #fff8ee;
    cursor: pointer;
    font: 700 0.68rem var(--mono);
    text-transform: uppercase;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .dialog-close:hover { transform: rotate(-2deg); }
</style>
